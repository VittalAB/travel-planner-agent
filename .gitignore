# Keep the existing repository-root virtual environment local.
/.venv/

# Secrets and local environment configuration in either project.
/smart-travel-agent/**/.env*
!/smart-travel-agent/**/.env.example
!/smart-travel-agent/**/.env.*.example
/smart-travel-agent/**/*.env
/smart-travel-agent/**/secrets.toml
/smart-travel-agent/**/secrets/
/smart-travel-agent/**/credentials.json
/smart-travel-agent/**/service-account*.json
/smart-travel-agent/**/*.pem
/smart-travel-agent/**/*.key
/smart-travel-agent/**/*.p12
/smart-travel-agent/**/*.pfx
/smart-travel-agent/**/*.jks

/smart-travel-agent-ui/**/.env*
!/smart-travel-agent-ui/**/.env.example
!/smart-travel-agent-ui/**/.env.*.example
/smart-travel-agent-ui/**/*.env
/smart-travel-agent-ui/**/secrets.toml
/smart-travel-agent-ui/**/secrets/
/smart-travel-agent-ui/**/credentials.json
/smart-travel-agent-ui/**/service-account*.json
/smart-travel-agent-ui/**/*.pem
/smart-travel-agent-ui/**/*.key
/smart-travel-agent-ui/**/*.p12
/smart-travel-agent-ui/**/*.pfx
/smart-travel-agent-ui/**/*.jks

